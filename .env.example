# ==============================================================================
# BHU-GIT MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Important: Never place privileged credentials in client-side NEXT_PUBLIC_* variables.

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT FIREBASE CREDENTIALS (EXPOSED TO BROWSER)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=mock-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bhu-git-demo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bhu-git-demo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bhu-git-demo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:mockappid
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://bhu-git-demo-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE PRIVILEGED FIREBASE ADMIN CREDENTIALS (NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-demo@bhu-git-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. GIS MAP & APPLICATION SYSTEM SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_DEFAULT_WARD=Ward 12

# ------------------------------------------------------------------------------
# 4. SECURITY & RESOURCE LIMITS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_REQUESTS_PER_MIN=60
